{
  "manifest_version": 3,
  "name": "Dia Command Bar",
  "version": "1.2.3",
  "description": "An Arc-inspired command bar. Search, jump between tabs, and go anywhere from a quieter new tab.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "search"],
  "optional_permissions": ["bookmarks", "history"],
  "optional_host_permissions": ["https://suggestqueries.google.com/*", "http://*/*", "https://*/*"],
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Open Dia Command Bar",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "commands": {
    "open-command-bar": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Open the command bar over the current page"
    }
  },
  "web_accessible_resources": [{
    "resources": ["newtab.html", "app.js", "core.js", "styles.css", "icons/mark.svg"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  }
}
